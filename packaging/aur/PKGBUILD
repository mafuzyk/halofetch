# Maintainer: mafuzyk <mafuzyk@gmail.com>

pkgname=halofetch
pkgver=3.3.0
pkgrel=1
pkgdesc="System information fetch with centered logos, panels and a live monitor"
arch=('x86_64')
url="https://github.com/mafuzyk/halofetch"
license=('GPL-3.0-or-later')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=('wireless_tools: show the Wi-Fi network name')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('73b4b4befeb2c0b8314d6991c79894396cf407b561712f77d42eb9fe3d862c2b')

prepare() {
  cd "$pkgname-$pkgver"
  cargo fetch --locked
}

build() {
  cd "$pkgname-$pkgver"
  cargo build --frozen --release --locked
}

check() {
  cd "$pkgname-$pkgver"
  cargo test --frozen --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/halofetch "$pkgdir/usr/bin/halofetch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 THIRD_PARTY_NOTICES.md "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY_NOTICES.md"
  install -Dm644 DOCS.md "$pkgdir/usr/share/doc/$pkgname/DOCS.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 logos/README.md "$pkgdir/usr/share/doc/$pkgname/logo-provenance.md"
}
